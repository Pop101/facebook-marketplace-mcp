# Copy to facebook-marketplace-mcp.env with mode 0600. Do not commit it.
# Export the Cookie request header from a currently authenticated Facebook browser session.
FACEBOOK_COOKIE_HEADER="c_user=...; xs=...; datr=..."
# Must match the static bearer token configured in mcp-front's nginx map.
MCP_API_KEY="replace-with-shared-mcp-api-key"
